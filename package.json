{
  "name": "obsidian-fantasy-map-generator",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "An Obsidian plugin that edits Azgaar's Fantasy Map Generator .map files inside the vault.",
  "scripts": {
    "build": "tsdown && tsx scripts/build-fmg.ts",
    "build:fmg": "tsx scripts/fetch-fmg.ts",
    "build:release": "npm run build:fmg && tsdown && tsx scripts/build-fmg.ts --require-fmg",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=26.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "enumwaii": "2.0.0",
    "obsidian": "1.13.1",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
